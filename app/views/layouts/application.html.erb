<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="delete-modal" data-delete-modal-default-message-value="<%= t("delete_modal.default_message") %>" class="min-h-screen bg-stone-100 text-stone-900">
    <% if notice.present? || alert.present? %>
      <div class="fixed inset-x-0 top-4 z-50 mx-auto flex max-w-xl flex-col gap-2 px-4">
        <% if notice.present? %>
          <p class="rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 shadow-sm"><%= notice %></p>
        <% end %>
        <% if alert.present? %>
          <p class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800 shadow-sm"><%= alert %></p>
        <% end %>
      </div>
    <% end %>

    <% if user_signed_in? %>
      <header class="border-b border-stone-200 bg-white/90 backdrop-blur">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.24em] text-stone-500"><%= t("app.name") %></p>
            <p class="mt-1 text-sm text-stone-600"><%= t("layout.signed_in_as_html", username: content_tag(:span, current_user.username, class: "font-medium text-stone-900")) %></p>
          </div>

          <div class="flex items-center gap-3">
            <%= form_with url: request.path, method: :get, class: "flex items-center gap-2" do %>
              <label for="locale-switcher" class="text-sm font-medium text-stone-600"><%= t("layout.language") %></label>
              <%= select_tag :locale,
                options_for_select([
                  [t("locales.fr"), "fr"],
                  [t("locales.en"), "en"]
                ], I18n.locale),
                id: "locale-switcher",
                onchange: "this.form.requestSubmit()",
                class: "rounded-full border border-stone-300 bg-white px-3 py-2 text-sm text-stone-700 outline-none transition hover:border-stone-400" %>
            <% end %>

            <%= button_to t("layout.sign_out"), destroy_user_session_path, method: :delete, class: "inline-flex items-center justify-center rounded-full border border-stone-300 bg-white px-4 py-2 text-sm font-semibold text-stone-700 transition hover:border-stone-400 hover:bg-stone-50" %>
          </div>
        </div>
      </header>
    <% end %>

    <%= yield %>

    <div data-delete-modal-target="modal" data-action="click->delete-modal#closeBackground" class="fixed inset-0 z-50 hidden bg-stone-950/50 px-4 py-6">
      <div class="mx-auto flex min-h-full max-w-md items-center justify-center">
        <div class="w-full rounded-3xl bg-white p-6 shadow-xl">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p data-delete-modal-target="message" class="mt-2 text-sm leading-6 text-stone-600"><%= t("delete_modal.default_message") %></p>
            </div>
          </div>

          <div class="mt-6 flex items-center justify-end gap-3">
            <button type="button" data-action="delete-modal#close" class="inline-flex items-center justify-center rounded-full border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-700 transition hover:bg-stone-50">
              <%= t("actions.cancel") %>
            </button>

            <form data-delete-modal-target="form" data-action="submit->delete-modal#submit" action="#" method="post" class="inline-block">
              <input type="hidden" name="_method" value="delete">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

              <button type="submit" class="inline-flex items-center justify-center rounded-full bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-500">
                <%= t("actions.delete") %>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

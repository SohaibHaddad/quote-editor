<div class="min-h-screen bg-stone-100 px-6 py-12 text-stone-900">
  <div class="mx-auto flex max-w-5xl flex-col gap-10">
    <header class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">Tailwind Example</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-stone-950 sm:text-5xl">
        Quote editor UI building block
      </h1>
      <p class="mt-4 text-lg leading-8 text-stone-600">
        This page includes a single card-style component using Tailwind utility classes. Edit the class list here
        to see changes reflected immediately during development.
      </p>
    </header>

    <section class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <article class="overflow-hidden rounded-[2rem] border border-stone-200 bg-white shadow-[0_20px_60px_-30px_rgba(0,0,0,0.25)]">
        <div class="border-b border-stone-200 bg-gradient-to-r from-emerald-500 to-teal-500 px-8 py-8 text-white">
          <p class="text-sm font-medium uppercase tracking-[0.25em] text-emerald-50/90">Featured Component</p>
          <h2 class="mt-3 text-2xl font-semibold">Quote Preview Card</h2>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-emerald-50/90">
            A simple component example with spacing, rounded corners, background gradients, and action buttons.
          </p>
        </div>

        <div class="space-y-6 px-8 py-8">
          <blockquote class="border-l-4 border-emerald-500 pl-5 text-xl leading-8 text-stone-800">
            “Good interfaces make the important path obvious and the secondary path still available.”
          </blockquote>

          <div class="flex flex-wrap items-center gap-3">
            <span class="inline-flex rounded-full bg-emerald-100 px-3 py-1 text-sm font-medium text-emerald-800">
              Draft
            </span>
            <span class="inline-flex rounded-full bg-stone-100 px-3 py-1 text-sm font-medium text-stone-600">
              2 min read
            </span>
          </div>

          <div class="flex flex-wrap gap-4">
            <button class="inline-flex items-center justify-center rounded-full bg-stone-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-stone-800">
              Save quote
            </button>
            <button class="inline-flex items-center justify-center rounded-full border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 transition hover:border-stone-400 hover:bg-stone-50">
              Preview changes
            </button>
          </div>
        </div>
      </article>

      <aside class="rounded-[1.5rem] border border-stone-200 bg-white p-6 shadow-sm">
        <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-stone-500">Classes used</h3>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-stone-600">
          <li><code class="rounded bg-stone-100 px-2 py-1 text-stone-800">bg-gradient-to-r</code></li>
          <li><code class="rounded bg-stone-100 px-2 py-1 text-stone-800">rounded-[2rem]</code></li>
          <li><code class="rounded bg-stone-100 px-2 py-1 text-stone-800">shadow-[...]</code></li>
          <li><code class="rounded bg-stone-100 px-2 py-1 text-stone-800">lg:grid-cols-[...]</code></li>
        </ul>
      </aside>

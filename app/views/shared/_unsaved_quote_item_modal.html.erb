<div data-quote-item-guard-target="modal" data-action="click->quote-item-guard#closeBackground" class="fixed inset-0 z-50 hidden bg-stone-950/50 px-4 py-6">
  <div class="mx-auto flex min-h-full max-w-md items-center justify-center">
    <div class="w-full rounded-3xl bg-white p-6 shadow-xl">
      <p data-quote-item-guard-target="message" class="text-sm leading-6 text-stone-600"><%= message %></p>

      <div class="mt-6 flex items-center justify-end">
        <button type="button" data-action="quote-item-guard#close" class="inline-flex items-center justify-center rounded-full border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-700 transition hover:bg-stone-50">
          <%= t("actions.ok") %>
        </button>
      </div>
    </div>
  </div>
</div>

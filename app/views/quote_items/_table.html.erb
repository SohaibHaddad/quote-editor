<section class="overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-sm">
  <% show_actions = !quote.validated? %>

  <div class="overflow-x-auto">
    <table class="min-w-full table-fixed divide-y divide-stone-200">
      <colgroup>
        <col>
        <col class="w-24">
        <col class="w-36">
        <col class="w-24">
        <col class="w-36">
        <col class="w-36">
        <% if show_actions %>
          <col class="w-36">
        <% end %>
      </colgroup>
      <thead class="bg-stone-50">
        <tr>
          <th class="px-4 py-4 text-left text-xs font-semibold uppercase tracking-wide text-stone-500"><%= t("quote_items.table.columns.article") %></th>
          <th class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wide text-stone-500"><%= t("quote_items.table.columns.quantity") %></th>
          <th class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wide text-stone-500"><%= t("quote_items.table.columns.unit_price_before_tax") %></th>
          <th class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wide text-stone-500"><%= t("quote_items.table.columns.tax_rate") %></th>
          <th class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wide text-stone-500"><%= t("quote_items.table.columns.total_ht") %></th>
          <th class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wide text-stone-500"><%= t("quote_items.table.columns.total_ttc") %></th>
          <% if show_actions %>
            <th class="px-4 py-4 text-left text-xs font-semibold uppercase tracking-wide text-stone-500"><%= t("quote_items.table.columns.actions") %></th>
          <% end %>
        </tr>
      </thead>
      <tbody id="quote_items_rows" class="divide-y divide-stone-200 bg-white">
        <% if quote_items.any? %>
          <% quote_items.each do |quote_item| %>
            <%= render "quote_items/row", quote: quote, quote_item: quote_item %>
          <% end %>
        <% else %>
          <tr id="empty_quote_items_row">
            <td colspan="<%= show_actions ? 7 : 6 %>" class="px-4 py-10 text-sm text-stone-600"><%= t("quote_items.table.empty_state") %></td>
          </tr>
        <% end %>
        <%= render "quote_items/new_row", quote: quote %>
      </tbody>
    </table>
  </div>
</section>

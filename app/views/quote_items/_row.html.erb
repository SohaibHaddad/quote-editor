<tr id="<%= dom_id(quote_item) %>" class="align-middle">
  <td class="px-4 py-4 text-sm font-medium text-stone-900"><%= quote_item.name %></td>
  <td class="px-3 py-4 text-sm text-stone-600"><%= quote_item.quantity %></td>
  <td class="px-3 py-4 text-sm text-stone-600"><%= number_to_currency(quote_item.unit_price_before_tax) %></td>
  <td class="px-3 py-4 text-sm text-stone-600"><%= number_to_percentage(quote_item.tax_rate, precision: 0) %></td>
  <td class="px-3 py-4 text-sm text-stone-900"><%= number_to_currency(quote_item.price_before_tax) %></td>
  <td class="px-3 py-4 text-sm font-medium text-stone-900"><%= number_to_currency(quote_item.price_after_tax) %></td>
  <% unless quote.validated? %>
    <td class="px-4 py-4">
      <div class="flex flex-wrap gap-2">
        <%= link_to edit_quote_quote_item_path(quote, quote_item), data: { turbo_stream: true }, title: "Edit", aria: { label: "Edit item" }, class: "inline-flex h-10 w-10 items-center justify-center rounded-full border border-emerald-300 text-emerald-800 transition hover:border-emerald-400 hover:bg-emerald-50" do %>
          <%= image_tag "icons/quote-edit.svg", alt: "", class: "h-4 w-4" %>
        <% end %>
        <button type="button" data-action="delete-modal#open" data-delete-url="<%= quote_quote_item_path(quote, quote_item) %>" data-delete-message="This item will be permanently removed from the quote." title="Delete" aria-label="Delete item" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-rose-300 bg-white text-rose-700 transition hover:bg-rose-50">
          <%= image_tag "icons/quote-delete.svg", alt: "", class: "h-4 w-4" %>
        </button>
      </div>
    </td>
  <% end %>
</tr>

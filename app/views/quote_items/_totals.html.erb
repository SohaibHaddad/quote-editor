<aside id="quote_totals" class="self-end rounded-3xl border border-stone-200 bg-white p-5 shadow-sm xl:sticky xl:top-6">
  <div class="space-y-3 text-sm">
    <div class="flex items-center justify-between gap-4">
      <span class="text-stone-500">Total HT</span>
      <span class="font-semibold text-stone-950"><%= number_to_currency(quote.total_price_before_tax) %></span>
    </div>
    <div class="flex items-center justify-between gap-4">
      <span class="text-stone-500">Total TVA</span>
      <span class="font-semibold text-stone-950"><%= number_to_currency(quote.total_tax) %></span>
    </div>
    <div class="flex items-center justify-between gap-4 border-t border-stone-200 pt-3">
      <span class="text-stone-700">Total TTC</span>
      <span class="text-lg font-semibold text-stone-950"><%= number_to_currency(quote.total_price_after_tax) %></span>
    </div>
  </div>

  <button class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-amber-400 px-5 py-3 text-sm font-semibold text-stone-950 transition hover:bg-amber-300" type="button">
    Validate quote
  </button>
</aside>

<aside id="quote_totals" class="self-end rounded-3xl border border-stone-200 bg-white p-5 shadow-sm xl:sticky xl:top-6">
  <div class="space-y-3 text-sm">
    <div class="flex items-center justify-between gap-4">
      <span class="text-stone-500"><%= t("quote_items.totals.total_ht") %></span>
      <span class="font-semibold text-stone-950"><%= number_to_currency(quote.total_price_before_tax) %></span>
    </div>
    <div class="flex items-center justify-between gap-4">
      <span class="text-stone-500"><%= t("quote_items.totals.total_tax") %></span>
      <span class="font-semibold text-stone-950"><%= number_to_currency(quote.total_tax) %></span>
    </div>
    <div class="flex items-center justify-between gap-4 border-t border-stone-200 pt-3">
      <span class="text-stone-700"><%= t("quote_items.totals.total_ttc") %></span>
      <span class="text-lg font-semibold text-stone-950"><%= number_to_currency(quote.total_price_after_tax) %></span>
    </div>
  </div>

  <% unless quote.validated? %>
    <%= button_to t("quote_items.totals.validate_quote"), validate_quote_quote_path(quote), method: :patch, disabled: !quote.can_validate_quote?, form: { data: { action: "submit->quote-item-guard#blockIfUnsaved" } }, class: "mt-6 inline-flex w-full items-center justify-center rounded-full px-5 py-3 text-sm font-semibold transition #{quote.can_validate_quote? ? "bg-amber-400 text-stone-950 hover:bg-amber-300" : "cursor-not-allowed bg-stone-200 text-stone-500"}" %>
  <% end %>
</aside>

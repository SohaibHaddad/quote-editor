<%= turbo_stream.replace "quotes_header" do %>
  <%= render "header", quotes: @quotes %>
<% end %>

<%= turbo_stream.replace "quotes_table" do %>
  <%= render "table", quotes: @quotes %>
<% end %>

<%= turbo_stream.replace "quote_form" do %>
  <%= turbo_frame_tag "quote_form" do %>
    <%= render "new_button" %>
  <% end %>
<% end %>

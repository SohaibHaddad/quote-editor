<section id="quotes_table" class="overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-sm">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-stone-200">
      <thead class="bg-stone-50">
        <tr>
          <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-stone-500"><%= t("quotes.index.columns.id") %></th>
          <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-stone-500"><%= t("quotes.index.columns.creation_date") %></th>
          <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-stone-500"><%= t("quotes.index.columns.name") %></th>
          <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-stone-500"><%= t("quotes.index.columns.state") %></th>
          <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-stone-500"><%= t("quotes.index.columns.actions") %></th>
        </tr>
      </thead>
      <tbody id="quotes_rows" class="divide-y divide-stone-200 bg-white">
        <% if quotes.any? %>
          <% quotes.each do |quote| %>
            <%= render "quote_row", quote: quote %>
          <% end %>
        <% else %>
          <tr id="empty_quotes_row">
            <td colspan="5" class="px-6 py-10 text-sm leading-7 text-stone-600">
              <%= t("quotes.index.empty_state") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

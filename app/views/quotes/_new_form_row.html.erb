<tr id="new_quote_row" class="bg-emerald-50 align-middle">
  <td colspan="5" class="px-6 py-5">
    <%= form_with model: quote, class: "space-y-4" do |f| %>
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end">
        <div class="w-full">
          <%= f.text_field :name, autofocus: true, placeholder: t("quotes.form.name_placeholder"), class: "block w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-stone-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200" %>
          <% if quote.errors.any? %>
            <p class="mt-2 text-sm text-rose-700"><%= quote.errors.full_messages.to_sentence %></p>
          <% end %>
        </div>

        <div class="flex shrink-0 flex-wrap gap-3">
          <%= f.button type: "submit", title: t("quotes.form.create_quote"), aria: { label: t("quotes.form.create_quote") }, class: "inline-flex h-12 w-12 items-center justify-center rounded-full bg-amber-400 text-stone-950 transition hover:bg-amber-300" do %>
            <%= image_tag "icons/quote-add.svg", alt: "", class: "h-5 w-5" %>
          <% end %>
          <%= link_to quotes_path, data: { turbo_frame: "_top" }, title: t("actions.cancel"), aria: { label: t("actions.cancel") }, class: "inline-flex h-12 w-12 items-center justify-center rounded-full border border-stone-300 text-stone-700 transition hover:bg-stone-50" do %>
            <%= image_tag "icons/quote-cancel.svg", alt: "", class: "h-5 w-5" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </td>
</tr>

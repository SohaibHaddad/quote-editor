<div class="min-h-36 rounded-3xl border border-stone-200 bg-white p-4 shadow-sm">
  <div class="flex min-h-28 items-center justify-center">
    <div class="w-full max-w-3xl">
      <% if quote.errors.any? %>
        <div class="mb-4 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
          <%= quote.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <%= form_with model: quote, class: "flex flex-col gap-3 lg:flex-row lg:items-center" do |f| %>
        <div class="w-full">
          <%= f.text_field :name, autofocus: true, placeholder: t("quotes.form.name_placeholder"), class: "block w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200" %>
        </div>

        <div class="flex shrink-0 flex-wrap gap-3">
          <%= f.button type: "submit", title: quote.persisted? ? t("actions.save_changes") : t("quotes.form.create_quote"), aria: { label: quote.persisted? ? t("actions.save_changes") : t("quotes.form.create_quote") }, class: "inline-flex h-12 w-12 items-center justify-center rounded-full bg-amber-400 text-stone-950 transition hover:bg-amber-300" do %>
            <%= image_tag(quote.persisted? ? "icons/quote-edit.svg" : "icons/quote-add.svg", alt: "", class: "h-5 w-5") %>
          <% end %>
          <% unless quote.persisted? %>
            <%= link_to quotes_path, data: { turbo_frame: "_top" }, title: t("actions.cancel"), aria: { label: t("actions.cancel") }, class: "inline-flex h-12 w-12 items-center justify-center rounded-full border border-stone-300 text-stone-700 transition hover:bg-stone-50" do %>
              <%= image_tag "icons/quote-cancel.svg", alt: "", class: "h-5 w-5" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

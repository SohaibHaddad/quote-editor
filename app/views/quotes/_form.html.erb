<div class="min-h-36 rounded-3xl border border-stone-200 bg-white p-4 shadow-sm">
  <div class="flex min-h-28 items-center justify-center">
    <div class="w-full max-w-3xl">
      <% if quote.errors.any? %>
        <div class="mb-4 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
          <%= quote.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <%= form_with model: quote, class: "flex flex-col gap-3 lg:flex-row lg:items-center" do |f| %>
        <div class="w-full">
          <%= f.text_field :name, autofocus: true, placeholder: "Quote name", class: "block w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200" %>
        </div>

        <div class="flex shrink-0 flex-wrap gap-3">
          <%= f.submit(quote.persisted? ? "Save changes" : "Create quote", class: "inline-flex min-h-12 items-center justify-center rounded-full bg-stone-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-stone-800") %>
          <% unless quote.persisted? %>
            <%= link_to "Cancel", quotes_path, data: { turbo_frame: "_top" }, class: "inline-flex min-h-12 items-center justify-center rounded-full border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 transition hover:bg-stone-50" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

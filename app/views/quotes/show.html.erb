<div class="mx-auto flex min-h-screen w-full max-w-6xl flex-col gap-8 px-6 py-10">
  <section class="flex flex-col gap-6 rounded-3xl border border-stone-200 bg-white p-8 shadow-lg">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <%= link_to quotes_path, class: "inline-flex items-center gap-2 rounded-full border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-700 transition hover:bg-stone-50" do %>
        <span aria-hidden="true">&larr;</span>
        <span>Save and quit</span>
      <% end %>

      <span class="rounded-full bg-violet-100 px-4 py-2 text-sm font-semibold text-violet-700">In progress</span>
    </div>

    <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-stone-500">Quote</p>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <h1 class="text-4xl font-semibold tracking-tight text-stone-950"><%= @quote.name %></h1>
          <span class="rounded-full bg-violet-100 px-3 py-1 text-sm font-semibold text-violet-700">Quote #<%= @quote.id %></span>
        </div>
        <p class="mt-3 text-sm text-stone-600">
          Created on <%= @quote.created_at.strftime("%Y-%m-%d") %> by <%= @quote.created_by.username %>.
        </p>
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-8">
    <%= render "quote_items/table", quote: @quote, quote_items: @quote_items %>

    <div class="flex justify-end">
      <div class="w-full max-w-xs">
        <%= render "quote_items/totals", quote: @quote %>
      </div>
    </div>
  </section>
</div>

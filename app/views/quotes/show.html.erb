<div data-controller="quote-item-guard" data-quote-item-guard-form-row-selector-value="[data-quote-item-form-row='true']" data-quote-item-guard-message-value="<%= t("quote_items.unsaved_changes.message") %>" class="mx-auto flex min-h-screen w-full max-w-6xl flex-col gap-8 px-6 py-10">
  <section class="flex flex-col gap-6 rounded-3xl border border-stone-200 bg-white p-8 shadow-lg">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <%= link_to quotes_path, data: { action: "click->quote-item-guard#blockIfUnsaved" }, class: "inline-flex items-center gap-2 rounded-full border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-700 transition hover:bg-stone-50" do %>
        <span aria-hidden="true">&larr;</span>
        <span><%= t("quotes.show.back") %></span>
      <% end %>

      <% if @quote.validated? %>
        <span class="rounded-full bg-emerald-100 px-4 py-2 text-sm font-semibold text-emerald-700"><%= t("quotes.states.validated") %></span>
      <% else %>
        <span class="rounded-full bg-violet-100 px-4 py-2 text-sm font-semibold text-violet-700"><%= t("quotes.states.in_draft") %></span>
      <% end %>
    </div>

    <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <h1 class="text-4xl font-semibold tracking-tight text-stone-950"><%= @quote.name %></h1>
          <span class="rounded-full bg-violet-100 px-3 py-1 text-sm font-semibold text-violet-700"><%= t("quotes.show.quote_number", id: @quote.id) %></span>
        </div>
        <p class="mt-3 text-sm text-stone-600">
          <%= t("quotes.show.created_on", date: l(@quote.created_at.to_date, format: :default), username: @quote.created_by.username) %>
        </p>
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-8">
    <%= render "quote_items/table", quote: @quote, quote_items: @quote_items %>

    <div class="flex justify-end">
      <div class="w-full max-w-xs">
        <%= render "quote_items/totals", quote: @quote %>
      </div>
    </div>
  </section>

  <%= render "shared/unsaved_quote_item_modal", message: t("quote_items.unsaved_changes.message") %>
</div>

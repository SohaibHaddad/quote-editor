<div class="flex min-h-screen items-center justify-center px-6 py-12">
  <div class="grid w-full max-w-5xl overflow-hidden rounded-[2rem] border border-stone-200 bg-white shadow-[0_25px_80px_-35px_rgba(0,0,0,0.3)] lg:grid-cols-[1.15fr_0.85fr]">
    <section class="hidden bg-[radial-gradient(circle_at_top_left,_rgba(16,185,129,0.35),_transparent_35%),linear-gradient(135deg,_#052e2b,_#0f766e)] p-10 text-white lg:flex lg:flex-col lg:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-emerald-100/80">Quote Editor</p>
        <h1 class="mt-6 max-w-md text-4xl font-semibold tracking-tight">
          Sign in with your seeded account.
        </h1>
        <p class="mt-4 max-w-lg text-base leading-7 text-emerald-50/80">
          Access is limited to existing users. New accounts are created through seeds, not from the UI.
        </p>
      </div>

      <div class="rounded-[1.5rem] border border-white/10 bg-white/10 p-6 backdrop-blur">
        <p class="text-sm uppercase tracking-[0.25em] text-emerald-100/75">Login</p>
        <p class="mt-3 text-sm leading-6 text-emerald-50/80">
          Use your username and password. If you need another account, add it in `db/seeds.rb`.
        </p>
      </div>
    </section>

    <section class="flex items-center p-6 sm:p-10">
      <div class="mx-auto w-full max-w-md">
        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-emerald-700">Welcome Back</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-stone-950">Sign in</h2>
        <p class="mt-3 text-sm leading-6 text-stone-600">
          Enter the credentials for a seeded user account.
        </p>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
          <div>
            <%= f.label :username, class: "mb-2 block text-sm font-medium text-stone-700" %>
            <%= f.text_field :username, autofocus: true, autocomplete: "username", class: "block w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-stone-900 outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/15" %>
          </div>

          <div>
            <%= f.label :password, class: "mb-2 block text-sm font-medium text-stone-700" %>
            <%= f.password_field :password, autocomplete: "current-password", class: "block w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-stone-900 outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/15" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <label class="flex items-center gap-3 text-sm text-stone-600">
              <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" %>
              <span>Remember me</span>
            </label>
          <% end %>

          <%= f.submit "Sign in", class: "inline-flex w-full items-center justify-center rounded-full bg-stone-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-stone-800" %>
        <% end %>
      </div>
    </section>
  </div>
</div>
